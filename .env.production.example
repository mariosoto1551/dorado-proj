# Variables de entorno de PRODUCCIÓN — nombres sin valores (Fase 13).
# NADA de esto se comitea con valores reales: se carga en el panel de la
# plataforma (Render para backend, Vercel para frontends, CloudAMQP el broker).
# La lista completa y autoritativa por servicio está en cada apps/<svc>/README.md.
#
# Convención de secretos: [SECRETO] = nunca en el repo ni en logs.

# ─────────── Comunes a los 9 backend ───────────
GATEWAY_INTERNAL_SECRET=        # [SECRETO] mismo valor en los 9 servicios (Render lo genera una vez)
JWT_PUBLIC_KEY=                 # clave pública RS256 (base64) — los 9 servicios
RABBITMQ_URL=                   # [SECRETO] amqps://... de CloudAMQP — los 8 servicios con bus (no el gateway)
LOG_LEVEL=info

# ─────────── identity-service (:3001) ───────────
DATABASE_URL=                   # [SECRETO] postgres .../identity_db
JWT_PRIVATE_KEY=                # [SECRETO] clave privada RS256 (base64) — SOLO identity
BILLING_INTERNAL_URL=           # http://billing-service:3002 (interno de Render)
REFRESH_COOKIE_SECURE=true

# ─────────── billing-service (:3002) ───────────
DATABASE_URL=                   # [SECRETO] .../billing_db

# ─────────── activity-service (:3003) ───────────
DATABASE_URL=                   # [SECRETO] .../activity_db
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
BILLING_INTERNAL_URL=           # http://billing-service:3002
SESSION_INTERNAL_URL=           # http://session-service:3004

# ─────────── session-service (:3004) — scheduler cron, NO puede dormir ───────────
DATABASE_URL=                   # [SECRETO] .../session_db
IDENTITY_INTERNAL_URL=          # http://identity-service:3001

# ─────────── scoring-service (:3005) ───────────
DATABASE_URL=                   # [SECRETO] .../scoring_db
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
SESSION_INTERNAL_URL=           # http://session-service:3004

# ─────────── rewards-service (:3006) ───────────
DATABASE_URL=                   # [SECRETO] .../rewards_db
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
SCORING_INTERNAL_URL=           # http://scoring-service:3005
ACTIVITY_INTERNAL_URL=          # http://activity-service:3003

# ─────────── notification-service (:3007) ───────────
DATABASE_URL=                   # [SECRETO] .../notification_db
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
ACTIVITY_INTERNAL_URL=          # http://activity-service:3003

# ─────────── audit-service (:3008) ───────────
DATABASE_URL=                   # [SECRETO] .../audit_db

# ─────────── ai-service (:3009) — asistente de IA (fase-14-29) ───────────
# Sin RABBITMQ_URL: no publica ni consume eventos (decisión 15).
DATABASE_URL=                   # [SECRETO] .../ai_db
BILLING_INTERNAL_URL=           # http://billing-service:3002 (feature + cuota del plan)
# Los cuatro orígenes de las herramientas de LECTURA. Requeridos: el servicio
# no levanta sin ellos, para no dejar herramientas que fallan de a una en
# medio de una conversación.
ACTIVITY_INTERNAL_URL=          # http://activity-service:3003
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
SCORING_INTERNAL_URL=           # http://scoring-service:3005
REWARDS_INTERNAL_URL=           # http://rewards-service:3006
# [SECRETO] Key de un SERVICE ACCOUNT de un PROJECT de OpenAI (dorado-prod),
# nunca una key personal. Vive SOLO acá: ningún otro servicio ni app-web.
OPENAI_API_KEY=
OPENAI_MODEL=                   # el vigente al desplegar (ver tanda 4)

# ─────────── gateway (:3000) — único público ───────────
TRUST_PROXY=1                   # saltos de proxy delante (1 = balanceador de Render o Caddy).
                                # Sin esto el rate limiting cuenta por la IP del proxy y todos
                                # los usuarios comparten un solo balde. `true` NO se acepta.
# HSTS=true                     # por defecto ya se manda cuando TRUST_PROXY está definido
APP_WEB_URL=                    # https://<app-web>.vercel.app (CORS)
PUBLIC_SITE_URL=                # https://<public-site>.vercel.app (CORS)
ADMIN_WEB_URL=                  # https://<admin-web>.vercel.app (CORS) — opcional,
                                # solo si desplegás el panel de PLATFORM_ADMIN
IDENTITY_INTERNAL_URL=          # http://identity-service:3001
BILLING_INTERNAL_URL=           # http://billing-service:3002
ACTIVITY_INTERNAL_URL=          # http://activity-service:3003
SESSION_INTERNAL_URL=           # http://session-service:3004
SCORING_INTERNAL_URL=           # http://scoring-service:3005
REWARDS_INTERNAL_URL=           # http://rewards-service:3006
NOTIFICATION_INTERNAL_URL=      # http://notification-service:3007
AUDIT_INTERNAL_URL=             # http://audit-service:3008
AI_INTERNAL_URL=                # http://ai-service:3009 (fase-14-29)

# ─────────── public-site (Vercel, build time) ───────────
PUBLIC_GATEWAY_URL=             # https://<gateway>.onrender.com
PUBLIC_APP_WEB_URL=             # https://<app-web>.vercel.app
SITE_URL=                       # https://<dominio-del-sitio>

# ─────────── app-web (Vercel) ───────────
# apiBaseUrl NO es env de Vercel: se fija en src/environments/environment.prod.ts
# (fileReplacements del build de producción) = https://<gateway>.onrender.com/api
