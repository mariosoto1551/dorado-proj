# gateway — plantilla de variables de entorno (copiar a .env en este mismo
# directorio y completar). El Gateway NO arranca si falta alguna requerida o
# tiene formato inválido (ADR-00 §8, ver src/config/env.schema.ts).

PORT=3000

# Clave pública RS256 (ADR-00 §3), PEM codificado en base64 (una línea).
# El MISMO valor que JWT_PUBLIC_KEY de identity-service (la privada NO va acá:
# solo identity emite tokens). Generar par con: node tools/generar-claves-jwt.mjs
JWT_PUBLIC_KEY=

# Secreto compartido para tráfico interno (ADR-00 §4). Mismo valor en el
# Gateway y en todos los servicios.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod

# Orígenes de navegador permitidos por CORS (lista explícita, nunca '*').
APP_WEB_URL=http://localhost:4200
PUBLIC_SITE_URL=http://localhost:4321

# URLs internas por servicio (tabla de ruteo, spec fase-03). Un prefijo cuyo
# servicio no tiene URL configurada responde 503 hasta que su fase lo levante.
IDENTITY_INTERNAL_URL=http://localhost:3001
BILLING_INTERNAL_URL=http://localhost:3002
ACTIVITY_INTERNAL_URL=http://localhost:3003
SESSION_INTERNAL_URL=http://localhost:3004
SCORING_INTERNAL_URL=http://localhost:3005
REWARDS_INTERNAL_URL=http://localhost:3006
# NOTIFICATION_INTERNAL_URL=http://localhost:3007   (Fase 9)
# AUDIT_INTERNAL_URL=http://localhost:3008          (Fase 9)

# Opcional: trace | debug | info | warn | error (default info).
LOG_LEVEL=debug
