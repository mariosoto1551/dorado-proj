# activity-service — plantilla de variables de entorno (copiar a .env en este
# mismo directorio y completar). El servicio NO arranca si falta alguna
# requerida o tiene formato inválido (ADR-00 §8, ver src/config/env.schema.ts).

PORT=3003

# Base propia del servicio (una base por servicio — ADR-00 §2).
DATABASE_URL=postgresql://dorado:dorado_dev@localhost:5432/activity_db

# Secreto compartido para rutas /internal/* y llamadas internas salientes
# (ADR-00 §4). Mismo valor en Gateway y en todos los servicios.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod

# Clave pública RS256 (ADR-00 §3), PEM codificado en base64 (una línea).
# El MISMO valor que JWT_PUBLIC_KEY de identity-service (la privada NO va acá:
# solo identity emite tokens).
JWT_PUBLIC_KEY=

# REST interno (ADR-00 §4): billing para entitlements (límite de actividades
# por grupo), identity para validar grupos/usuarios y Grupo.timezone, session
# para resolver la Sección/Sesión ABIERTA donde registrar (fase-07).
BILLING_INTERNAL_URL=http://localhost:3002
IDENTITY_INTERNAL_URL=http://localhost:3001
SESSION_INTERNAL_URL=http://localhost:3004

# RabbitMQ (ADR-00 §5): fase-07 PUBLICA ActividadCompletada/NoHizoRegistrado/
# ConductaRegistrada/ConductaRegistroEliminado (no consume nada).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Opcional: trace | debug | info | warn | error (default info).
LOG_LEVEL=debug
