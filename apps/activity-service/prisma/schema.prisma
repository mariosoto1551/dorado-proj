// Schema de activity-service (base activity_db) — fuentes:
// docs/phases/fase-05-activity-catalog.md (catálogo) y
// docs/phases/fase-07-scoring-engine.md Parte A (registro).
// Convenciones no negociables (ADR-00 §6): IDs uuid v4, multi-tenancy por fila
// (organizacionId + grupoId indexados), puntos siempre Int.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoPuntaje {
  OPCIONAL // suma puntos al completarse
  OBLIGATORIA // resta puntos si se marca "no hizo"
}

// Comportamiento de una OBLIGATORIA al cerrar la Sesión (fase-14-08). Solo
// relevante con tipoPuntaje = OBLIGATORIA; para OPCIONAL se fuerza ASUME_HECHA.
enum ComportamientoAlCierre {
  ASUME_HECHA // comportamiento actual: sin registro positivo, sin castigo automático
  REQUIERE_CONFIRMACION // el Usuario debe confirmar; si no, no-hizo automático al cerrar la Sesión
}

enum TipoLimiteTiempo {
  DEADLINE // fecha/hora límite fija dentro de la Sesión
  CRONOMETRO // duración desde que el usuario la inicia
  SIN_LIMITE
}

// Alcance de una actividad (fase-14-09). INDIVIDUAL = clásico. EQUIPO = la
// completa el jefe una vez y scoring reparte a los miembros (siempre OPCIONAL).
enum AlcanceActividad {
  INDIVIDUAL
  EQUIPO
}

enum EstadoReporte {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Quién creó la actividad (fase-14-10). TUTOR = catálogo del grupo, visible
// para todos. USUARIO = actividad PERSONAL de su autor (solo él la ve y la
// completa; los tutores la ven para moderar).
enum OrigenActividad {
  TUTOR
  USUARIO
}

// Quién puede crear contenido en el catálogo del Grupo (fase-14-10, decisión 1).
enum ModoCreacionContenidoUsuario {
  RESTRICTIVO // default: solo Tutor/ORG_ADMIN (comportamiento previo a fase-14-10)
  BAJO_APROBACION // el integrante propone; el Tutor aprueba o rechaza
  LIBRE // el integrante crea y su actividad queda ACTIVA al instante
}

enum EstadoPropuesta {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoConducta {
  BUENA
  MALA
}

// Clase de registro sobre el que cuelga una nota interna (fase-14-18). No es
// una FK polimórfica de Prisma: son tres tablas distintas y la integridad la
// garantiza el endpoint, que valida el registro antes de escribir la nota.
enum TipoRegistroHistorial {
  ACTIVIDAD
  CONDUCTA
  TAREA_EQUIPO
}

enum EstadoCatalogo {
  ACTIVA
  ARCHIVADA
}

model Actividad {
  id                         String           @id @default(uuid())
  organizacionId             String
  grupoId                    String
  nombre                     String
  descripcion                String?
  tipoPuntaje                TipoPuntaje
  // siempre positivo; el signo se aplica al registrar (Fase 7). En una
  // OBLIGATORIA es el CASTIGO por no hacerla.
  valorPuntos                Int
  // fase-14-20: lo que SUMA cumplir una obligatoria confirmable (+2 frente a un
  // castigo de −10, por ejemplo). Default 0 ⇒ toda actividad preexistente
  // conserva el comportamiento del ítem 8 (confirmar valía 0). Se fuerza a 0
  // fuera de OBLIGATORIA + REQUIERE_CONFIRMACION (spec, decisión 4).
  puntosPorCumplir           Int              @default(0)
  tipoLimiteTiempo           TipoLimiteTiempo
  // "HH:mm", solo si tipoLimiteTiempo = DEADLINE, hora local del Grupo
  deadlineHora               String?
  // solo si tipoLimiteTiempo = CRONOMETRO
  duracionCronometroMinutos  Int?
  repeticionesMaximasSesion  Int              @default(1)
  // fase-14-25: cuántas confirmaciones hacen falta para NO perder puntos al
  // cerrar la Sesión. Default 1 ⇒ toda actividad preexistente conserva el
  // comportamiento del ítem 8 (con una confirmación alcanzaba). Se fuerza a 1
  // fuera de OBLIGATORIA + REQUIERE_CONFIRMACION y nunca supera a
  // repeticionesMaximasSesion (spec fase-14-25, decisiones 9-11).
  repeticionesMinimasSesion  Int              @default(1)
  // null = sin override; se calcula en Fase 7 como
  // repeticionesMaximasSesion * cantidad de Sesiones de la Sección
  repeticionesMaximasSeccion Int?
  // fase-14-08: default garantiza que toda actividad preexistente conserva el
  // comportamiento actual tras la migración (cambio retro-compatible).
  comportamientoAlCierre     ComportamientoAlCierre @default(ASUME_HECHA)
  // fase-14-09: alcance de equipo + bono al jefe. Default INDIVIDUAL/0 mantiene
  // el comportamiento previo (migración retro-compatible).
  alcance                    AlcanceActividad @default(INDIVIDUAL)
  bonoJefePuntos             Int              @default(0)
  // fase-14-11: días de la semana en que se puede registrar. 0 = domingo … 6 =
  // sábado (misma convención que los cron de session-service). Vacío = todos
  // los días, que es el default y el comportamiento previo al ítem 11.
  diasSemana                 Int[]            @default([])
  // fase-14-17: la opcional aparece en la lista del integrante SIN que él la
  // elija. Solo relevante con `planDelDiaActivo`; default false = se elige,
  // que con el modo apagado da igual (comportamiento previo intacto).
  siempreVisible             Boolean          @default(false)
  // fase-14-19: ids de RolGrupo (identity) que pueden verla y registrarla. SIN
  // FK: son de otra base (regla 2), se validan por REST interno al escribir.
  // Vacío = la ven todos, que es el default y el comportamiento previo al ítem.
  rolesPermitidos            String[]         @default([])
  // fase-14-24: destinatario NOMINAL — ids de Usuario (identity). Misma forma y
  // mismo criterio que `rolesPermitidos`: sin FK, validados por REST al escribir.
  // La diferencia con el rol es de intención, no de mecánica (decisión 3): el rol
  // es dinámico (quien lo reciba mañana queda incluido), esta lista es estática.
  usuariosPermitidos         String[]         @default([])
  // fase-14-24: ids de Equipo (identity). Solo con alcance = EQUIPO (decisión 5).
  equiposPermitidos          String[]         @default([])
  // fase-14-24: vigencia. Fecha CIVIL "YYYY-MM-DD" en el calendario local del
  // Grupo, no un DateTime (decisión 9) — misma convención que `deadlineHora`,
  // que guarda "HH:mm" local desde Fase 7. Un DateTime obligaría a decidir a qué
  // hora y en qué zona empieza el "1 de marzo", que es justo el error que el
  // ítem 11 se cuidó de no cometer. Los dos null = permanente (default).
  vigenteDesde               String?
  vigenteHasta               String?
  estado                     EstadoCatalogo   @default(ACTIVA)
  // fase-14-10: default TUTOR + autor nulo ⇒ toda actividad preexistente
  // conserva el comportamiento actual (migración retro-compatible).
  origen                     OrigenActividad  @default(TUTOR)
  // Autor Y DUEÑO de una actividad personal; null si origen = TUTOR.
  creadaPorUsuarioId         String?
  // fase-14-10: pasa a nullable — una actividad creada en modo LIBRE no tiene
  // tutor detrás. En BAJO_APROBACION guarda el Tutor que la aprobó.
  creadaPorTutorId           String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([organizacionId])
  @@index([grupoId])
  @@index([grupoId, creadaPorUsuarioId])
}

// Configuración de creación de contenido por integrantes, por Grupo
// (fase-14-10, Parte A). Vive en activity porque es una regla DEL CATÁLOGO y el
// catálogo es de este servicio (sin cruce REST en el camino caliente, regla 2).
// Fila perezosa: si no existe, la lectura devuelve los defaults sin escribir.
model ConfiguracionContenidoGrupo {
  id                              String                       @id @default(uuid())
  organizacionId                  String
  grupoId                         String                       @unique
  modoCreacionUsuario             ModoCreacionContenidoUsuario @default(RESTRICTIVO)
  // Topes del contenido de integrantes (decisión 4): sin ellos el modo LIBRE es
  // un agujero de puntaje (crear "Respirar = 100 pts" y autocompletarla).
  maxPuntosActividadUsuario       Int                          @default(5)
  maxActividadesActivasPorUsuario Int                          @default(5)
  // fase-14-17: con true, las OPCIONALES individuales del catálogo del tutor se
  // ocultan de la lista hasta que el integrante las mete en su plan del día.
  // Default false ⇒ ningún grupo existente cambia de comportamiento.
  planDelDiaActivo                Boolean                      @default(false)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt

  @@index([organizacionId])
}

// fase-14-17: qué opcionales eligió hacer HOY un integrante. Estado OPERATIVO,
// no ledger (misma naturaleza que CronometroActivo): no vale puntos, no viaja a
// scoring y se BORRA físicamente al sacarla del plan — la regla 6 de CLAUDE.md
// protege lo que sostiene el puntaje, y esto no lo sostiene.
// Lleva organizacionId igual (regla 3): es una fila por usuario de un grupo.
model SeleccionPlanDia {
  id             String   @id @default(uuid())
  organizacionId String
  grupoId        String
  usuarioId      String
  actividadId    String
  sesionId       String
  createdAt      DateTime @default(now())

  // Hace idempotente el alta automática al completar (spec, decisión 9).
  @@unique([usuarioId, actividadId, sesionId])
  @@index([organizacionId])
  @@index([usuarioId, sesionId])
}

// Propuesta de actividad de un integrante (fase-14-10, Parte B). Objeto de
// WORKFLOW mutable — NO es el ledger: los puntos solo existen cuando la
// Actividad aprobada se completa por el camino normal (RegistroActividad +
// ActividadCompletada). Modelo aparte a propósito: una propuesta PENDIENTE no
// es una Actividad en un estado raro, así EstadoCatalogo queda intacto
// (decisión 6) y es imposible que valga puntos antes de aprobarse.
model PropuestaActividad {
  id                        String                       @id @default(uuid())
  organizacionId            String
  grupoId                   String
  creadaPorUsuarioId        String
  nombre                    String
  descripcion               String?
  valorPuntos               Int
  repeticionesMaximasSesion Int                          @default(1)
  estado                    EstadoPropuesta              @default(PENDIENTE)
  // Modo vigente al proponer: explica por qué una quedó aprobada sola.
  modoAlCrear               ModoCreacionContenidoUsuario
  resueltoPorId             String?
  // 'TUTOR' | 'SYSTEM' (SYSTEM = auto-aprobada por modo LIBRE, decisión 7)
  resueltoPorTipo           String?
  resueltoEn                DateTime?
  motivoRechazo             String?
  // Actividad creada al aprobar (traza el resultado).
  actividadId               String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  @@index([organizacionId])
  @@index([grupoId, estado])
  @@index([creadaPorUsuarioId])
}

enum TipoRegistroActividad {
  COMPLETADA
  NO_HIZO
}

// Ledger de registro (spec fase-07 Parte A): filas inmutables — sin updatedAt
// a propósito (ADR-00 §6). El puntaje NUNCA se guarda acá como acumulado: cada
// fila lleva su snapshot con signo y scoring-service deriva sumando.
model RegistroActividad {
  id             String                @id @default(uuid())
  organizacionId String
  grupoId        String
  usuarioId      String
  actividadId    String
  sesionId       String
  seccionId      String
  tipo           TipoRegistroActividad
  // positivo si COMPLETADA, negativo si NO_HIZO (signo aplicado al escribir)
  valorPuntosSnapshot Int
  registradoPorId     String
  // 'TUTOR' | 'USUARIO'
  registradoPorTipo   String
  // Soft-delete de una COMPLETADA que un tutor quita (fase-14): nunca DELETE
  // físico — scoring compensa vía evento (mismo patrón que RegistroConducta).
  // fase-14-12: también da de baja un NO_HIZO cuando el tutor lo deshace.
  eliminado           Boolean   @default(false)
  eliminadoPorTutorId String?
  eliminadoEn         DateTime?
  // fase-14-12: nota corta y opcional del tutor al marcar en rojo (NO_HIZO o
  // quita de una repetición). La ve el integrante en su pantalla.
  motivoTutor         String?
  // fase-14-12: el tutor deshizo su propia marca. NO se limpian eliminadoPorTutorId
  // ni eliminadoEn — la fila conserva la historia entera (quitó y después deshizo),
  // en vez de volver a un estado que finge que nunca pasó.
  revertidoPorTutorId String?
  revertidoEn         DateTime?
  // fase-14-33: la fila se cargó a una Sesión que NO era la abierta. NULL en
  // todo lo anterior a este ítem y en todo lo que se registra en el día — no es
  // un default que haya que backfillear, es la ausencia de la marca. El motivo
  // es obligatorio cuando el instante no es null, y lo valida el endpoint: la
  // base no sabe quién escribió ni en qué estado estaba la Sesión.
  cargadoRetroactivamenteEn DateTime?
  motivoRetroactivo         String?
  // fase-14-33: por qué se DESHIZO la marca en un día que ya había cerrado.
  // Columna propia y no un reuso de motivoRetroactivo: son dos hechos
  // distintos sobre la misma fila («apareció fuera de su día» / «se deshizo
  // fuera de su día») y pisar uno con el otro borraría, justo en la fila más
  // discutible del sistema, por qué había aparecido.
  motivoReversion           String?
  createdAt           DateTime  @default(now())

  @@index([organizacionId])
  @@index([usuarioId, actividadId, sesionId])
}

// Inmutable salvo el soft-delete explícito de la spec (eliminado +
// eliminadoPorTutorId + eliminadoEn): nunca UPDATE de los datos de negocio ni
// DELETE físico — scoring compensa vía evento, no se reescribe historia.
model RegistroConducta {
  id             String @id @default(uuid())
  organizacionId String
  grupoId        String
  usuarioId      String
  conductaId     String
  sesionId       String
  seccionId      String
  // positivo si conducta BUENA, negativo si MALA
  valorPuntosSnapshot Int
  registradoPorId     String
  // 'TUTOR' | 'USUARIO'
  registradoPorTipo   String
  eliminado           Boolean   @default(false)
  eliminadoPorTutorId String?
  eliminadoEn         DateTime?
  // fase-14-33: ver RegistroActividad.
  cargadoRetroactivamenteEn DateTime?
  motivoRetroactivo         String?
  createdAt           DateTime  @default(now())

  @@index([organizacionId])
  @@index([usuarioId, conductaId, sesionId])
}

// Estado operativo del límite CRONOMETRO (spec fase-07): una fila por
// usuario+actividad+sesión mientras el cronómetro corre; se borra al completar.
// Sin organizacionId a propósito (modelo de la spec): es operacional, no de
// negocio — el aislamiento lo garantiza el flujo (la Actividad y la Sesión ya
// se validan contra el tenant antes de tocar esta tabla).
model CronometroActivo {
  id          String   @id @default(uuid())
  usuarioId   String
  actividadId String
  sesionId    String
  iniciadoEn  DateTime @default(now())

  @@unique([usuarioId, actividadId, sesionId])
}

// Registro inmutable de una tarea de equipo completada (fase-14-09). Snapshot de
// la membresía y el reparto al momento de completar; el detalle por miembro viaja
// además en TareaEquipoCompletada hacia scoring. Sin updatedAt: inmutable, igual
// que RegistroActividad.
model RegistroTareaEquipo {
  id                    String   @id @default(uuid())
  organizacionId        String
  grupoId               String
  equipoId              String
  actividadId           String
  sesionId              String
  seccionId             String
  valorPuntosSnapshot   Int
  bonoJefeSnapshot      Int
  jefeUsuarioIdSnapshot String
  // [{ usuarioId, esJefe, puntos }] resuelto al completar.
  miembrosSnapshot      Json
  completadaPorId       String
  // 'USUARIO' (jefe) | 'TUTOR'
  completadaPorTipo     String
  // fase-14-13: el Tutor anuló la completada del equipo — todos los que
  // recibieron puntos por ella los pierden (incluido el bono del jefe).
  // Mismos nombres que el soft-delete de RegistroActividad/RegistroConducta:
  // tres modelos con el mismo concepto y tres nombres distintos sería peor que
  // la disonancia entre el campo (`eliminado`) y el botón ("Anular").
  eliminado             Boolean   @default(false)
  eliminadoPorTutorId   String?
  eliminadoEn           DateTime?
  motivoTutor           String?
  revertidoPorTutorId   String?
  revertidoEn           DateTime?
  // fase-14-33: ver RegistroActividad.
  cargadoRetroactivamenteEn DateTime?
  motivoRetroactivo         String?
  motivoReversion           String?
  createdAt             DateTime @default(now())

  @@index([organizacionId])
  @@index([equipoId, sesionId])
}

// Reporte del jefe de equipo contra un integrante por una conducta MALA concreta
// (fase-14-09). Objeto de WORKFLOW mutable (cambia de estado) — NO es el ledger:
// el asiento real lo crea RegistroConducta al aprobar el Tutor.
model ReporteMiembro {
  id                 String        @id @default(uuid())
  organizacionId     String
  grupoId            String
  equipoId           String
  reportadoUsuarioId String
  jefeUsuarioId      String
  // conducta MALA concreta reportada (requerida): el reporte no es libre.
  conductaId         String
  motivo             String?
  estado             EstadoReporte @default(PENDIENTE)
  resueltoPorTutorId String?
  // RegistroConducta creado al aprobar (traza el asiento aplicado).
  registroConductaId String?
  resueltoEn         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizacionId])
  @@index([grupoId, estado])
  @@index([equipoId])
}

model Conducta {
  id                 String         @id @default(uuid())
  organizacionId     String
  grupoId            String
  nombre             String
  tipo               TipoConducta
  // siempre positivo; signo aplicado según tipo al registrar (Fase 7)
  valorPuntos        Int
  // solo relevante si tipo = MALA; en BUENA se fuerza a false (spec fase-05)
  permiteAutoreporte Boolean        @default(false)
  estado             EstadoCatalogo @default(ACTIVA)
  creadaPorTutorId   String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([organizacionId])
  @@index([grupoId])
}

// Nota interna del Tutor sobre un registro del historial (fase-14-18). NO es
// ledger —no sostiene puntaje, no viaja a scoring, no genera evento— y por eso
// admite DELETE físico, mismo criterio que SeleccionPlanDia. Es lo contrario
// del `motivoTutor` de RegistroActividad: esto NO lo ve el integrante nunca.
// Sin FK al registro: son tres tablas de origen distintas y una FK polimórfica
// no se expresa en Prisma — la integridad la valida el endpoint antes de escribir.
model NotaRegistro {
  id             String                @id @default(uuid())
  organizacionId String
  grupoId        String
  registroTipo   TipoRegistroHistorial
  registroId     String
  texto          String
  autorTutorId   String
  createdAt      DateTime              @default(now())

  @@index([organizacionId])
  @@index([registroTipo, registroId])
}

// Idempotencia de consumidor (fase-14-08): activity pasa de productor puro a
// también consumir SesionCerrada para el castigo automático. Misma tabla y
// patrón que scoring-service (fase-07). Operacional — NO lleva organizacionId
// ni pasa por el filtro de tenant (el consumidor corre sin JWT).
model EventoProcesado {
  eventId     String   @id
  consumidor  String
  procesadoEn DateTime @default(now())
}

// ---- Turnos rotativos (fase-14-21) ----

enum ModoTurno {
  ORDEN_FIJO // se recorre la lista tal como la escribió el Tutor
  AZAR       // se barajan las POSICIONES al empezar cada vuelta (decisión 13)
}

enum FrecuenciaTurno {
  SESION  // rota cada día
  SECCION // rota cada semana
}

// Configuración de rotación de UNA actividad obligatoria (fase-14-21): a quién
// le toca hacerla hoy. Mutable — es configuración del catálogo, no ledger.
// `Actividad` NO cambia: toda actividad existente simplemente no tiene fila acá
// y se comporta igual que antes (retro-compatible sin columnas nuevas).
model TurnoActividad {
  id             String          @id @default(uuid())
  organizacionId String
  grupoId        String
  // 1:1 con la actividad: una actividad tiene una sola rotación.
  actividadId    String          @unique
  modo           ModoTurno       @default(ORDEN_FIJO)
  frecuencia     FrecuenciaTurno @default(SESION)
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  posiciones     PosicionTurno[]
  vueltas        VueltaTurno[]

  @@index([organizacionId])
  @@index([grupoId])
}

// Una posición de la secuencia. SIN unique sobre usuarioId a propósito
// (decisión 12): [José, Luciana, José, Alejandra] son 4 posiciones y 3 personas
// — la repetición es el punto del ítem, no un error de carga.
model PosicionTurno {
  id               String         @id @default(uuid())
  turnoActividadId String
  turnoActividad   TurnoActividad @relation(fields: [turnoActividadId], references: [id], onDelete: Cascade)
  orden            Int
  usuarioId        String

  @@unique([turnoActividadId, orden])
  @@index([turnoActividadId])
}

// La permutación SELLADA de una vuelta (decisión 15). Se escribe una vez, al
// empezarla, y no se toca: editar la secuencia afecta a la vuelta SIGUIENTE.
// En ORDEN_FIJO es la copia literal de las posiciones — se guarda igual, para
// que ambos modos se comporten idéntico ante una edición a mitad de vuelta.
model VueltaTurno {
  id               String         @id @default(uuid())
  organizacionId   String
  turnoActividadId String
  turnoActividad   TurnoActividad @relation(fields: [turnoActividadId], references: [id], onDelete: Cascade)
  numero           Int
  // Los usuarioId en el orden en que les va a tocar, con repeticiones.
  ordenUsuarioIds  String[]
  createdAt        DateTime       @default(now())

  @@unique([turnoActividadId, numero])
  @@index([organizacionId])
}

// A quién le tocó, en un día (frecuencia SESION) o en una semana (SECCION).
// Estado operativo, no ledger (decisión 16): reasignar ACTUALIZA la fila
// dejando el rastro de quién lo hizo y a quién le tocaba. Los puntos que se
// derivan de acá sí son ledger, y esos siguen las reglas de siempre.
model AsignacionTurno {
  id             String   @id @default(uuid())
  organizacionId String
  grupoId        String
  actividadId    String
  // El ámbito: sesionId si frecuencia=SESION, seccionId si SECCION. Un solo
  // campo para que el @@unique valga en los dos modos.
  ambitoId       String
  sesionId       String?
  seccionId      String
  // A quién le toca HOY (ya con la reasignación aplicada, si la hubo).
  usuarioId      String
  vueltaNumero   Int
  // Índice dentro de `VueltaTurno.ordenUsuarioIds` que consumió esta asignación.
  indice         Int
  // Rastro de la reasignación manual del Tutor (decisión 8).
  usuarioOriginalId    String?
  reasignadoPorTutorId String?
  reasignadoEn         DateTime?
  motivoReasignacion   String?
  createdAt      DateTime @default(now())

  @@unique([actividadId, ambitoId])
  @@index([organizacionId])
  @@index([grupoId, usuarioId])
}
