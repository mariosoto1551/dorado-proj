---
import Layout from '../layouts/Layout.astro';

/*
 * CONTENIDO EDITORIAL ESTÁTICO — no llama a billing-service (ver
 * fase-11-public-site.md y skill astro-public-site). Los límites de abajo se
 * mantienen sincronizados A MANO con el seed de Plan de billing-service:
 *   apps/billing-service/src/prisma/seed-planes.ts
 * FREE: 2 tutores · 5 usuarios · 1 grupo · 15 actividades/grupo.
 * PRO:  sin límites + white-label + reportes avanzados.
 * Si esos números cambian en el seed, actualizar esta página a mano.
 */

const check = true;

const filas = [
  { label: 'Grupos', free: '1', pro: 'Ilimitados' },
  { label: 'Tutores', free: '2', pro: 'Ilimitados' },
  { label: 'Participantes (usuarios)', free: '5', pro: 'Ilimitados' },
  { label: 'Actividades por grupo', free: '15', pro: 'Ilimitadas' },
  { label: 'Conductas y recompensas', free: check, pro: check },
  { label: 'Zonas y umbrales configurables', free: check, pro: check },
  { label: 'Historial auditable de puntos', free: check, pro: check },
  { label: 'Notificaciones in-app', free: check, pro: check },
  { label: 'Reportes avanzados', free: false, pro: check },
  { label: 'White-label (marca propia)', free: false, pro: check },
];

const planes = [
  {
    codigo: 'FREE',
    nombre: 'Free',
    precio: '$0',
    periodo: 'para siempre',
    resumen: 'Ideal para una familia o un grupo chico que arranca.',
    destacado: false,
    cta: 'Crear cuenta gratis',
    bullets: ['1 grupo', 'Hasta 2 tutores', 'Hasta 5 participantes', '15 actividades por grupo'],
  },
  {
    codigo: 'PRO',
    nombre: 'Pro',
    precio: 'A medida',
    periodo: 'sin límites',
    resumen: 'Para colegios, clubes y organizaciones que necesitan escalar.',
    destacado: true,
    cta: 'Crear cuenta',
    bullets: ['Grupos, tutores y usuarios ilimitados', 'Actividades ilimitadas', 'Reportes avanzados', 'White-label con tu marca'],
  },
];
---

<Layout
  title="Precios"
  description="Planes de Proyecto Dorado: Free para siempre (1 grupo, 2 tutores, 5 participantes, 15 actividades) o Pro sin límites con reportes avanzados y white-label."
  path="/precios"
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 h-96 w-[32rem] -translate-x-1/2 rounded-full bg-marca-400/20 blur-3xl dark:bg-marca-600/15"></div>
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-8 pt-16 text-center sm:px-8 sm:pt-24">
      <h1 class="text-balance text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        Precios simples y honestos
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
        Empezá gratis y quedate en Free todo el tiempo que quieras. Pasás a Pro solo
        cuando necesitás crecer sin límites.
      </p>
    </div>
  </section>

  <!-- Tarjetas de plan -->
  <section class="mx-auto max-w-5xl px-5 pb-8 sm:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        planes.map((p) => (
          <article
            class:list={[
              'reveal relative flex flex-col rounded-3xl border p-8 transition-transform duration-300 hover:-translate-y-1',
              p.destacado
                ? 'border-marca-300 bg-white shadow-2xl shadow-marca-600/10 ring-1 ring-marca-500/30 dark:border-marca-700 dark:bg-slate-900'
                : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900',
            ]}
          >
            {p.destacado && (
              <span class="absolute -top-3 left-8 rounded-full bg-marca-600 px-3 py-1 text-xs font-bold text-white shadow-md">
                Recomendado
              </span>
            )}
            <h2 class="text-sm font-bold uppercase tracking-wide text-marca-600 dark:text-marca-400">
              {p.nombre}
            </h2>
            <div class="mt-3 flex items-baseline gap-2">
              <span class="text-4xl font-extrabold text-slate-900 dark:text-white">{p.precio}</span>
              <span class="text-sm text-slate-400">{p.periodo}</span>
            </div>
            <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{p.resumen}</p>

            <ul class="mt-6 flex-1 space-y-3">
              {p.bullets.map((b) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-200">
                  <span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-marca-100 text-marca-600 dark:bg-marca-900/60 dark:text-marca-300" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </span>
                  {b}
                </li>
              ))}
            </ul>

            <a
              href="/registro"
              class:list={['mt-8', p.destacado ? 'btn-primario' : 'btn-secundario']}
            >
              {p.cta}
            </a>
          </article>
        ))
      }
    </div>
    <p class="reveal mt-6 text-center text-sm text-slate-400">
      El upgrade a Pro se coordina con el equipo — escribinos y activamos tu organización.
    </p>
  </section>

  <!-- Comparativa detallada -->
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8">
    <h2 class="reveal text-center text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
      Comparativa completa
    </h2>

    <div class="reveal mt-8 overflow-x-auto">
      <table class="w-full min-w-[32rem] border-collapse text-left">
        <caption class="sr-only">Comparación de características entre los planes Free y Pro</caption>
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800">
            <th scope="col" class="py-4 pr-4 text-sm font-semibold text-slate-500 dark:text-slate-400">Característica</th>
            <th scope="col" class="px-4 py-4 text-center text-sm font-bold text-slate-900 dark:text-white">Free</th>
            <th scope="col" class="px-4 py-4 text-center text-sm font-bold text-marca-600 dark:text-marca-400">Pro</th>
          </tr>
        </thead>
        <tbody>
          {
            filas.map((f) => (
              <tr class="border-b border-slate-100 dark:border-slate-800/70">
                <th scope="row" class="py-3.5 pr-4 text-sm font-medium text-slate-700 dark:text-slate-200">
                  {f.label}
                </th>
                <td class="px-4 py-3.5 text-center text-sm">
                  {
                    typeof f.free === 'boolean'
                      ? f.free
                        ? <span class="inline-block text-zona-verde" aria-label="Incluido"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
                        : <span class="inline-block text-slate-300 dark:text-slate-600" aria-label="No incluido"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
                      : <span class="font-semibold text-slate-700 dark:text-slate-200">{f.free}</span>
                  }
                </td>
                <td class="px-4 py-3.5 text-center text-sm">
                  {
                    typeof f.pro === 'boolean'
                      ? f.pro
                        ? <span class="inline-block text-zona-verde" aria-label="Incluido"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
                        : <span class="inline-block text-slate-300 dark:text-slate-600" aria-label="No incluido"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
                      : <span class="font-semibold text-marca-600 dark:text-marca-400">{f.pro}</span>
                  }
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Layout>
