---
import Layout from '../layouts/Layout.astro';
import HeroPagina from '../components/HeroPagina.astro';
import OtrosRoles from '../components/OtrosRoles.astro';
import { rolPorSlug } from '../data/roles';

/*
 * CONTENIDO EDITORIAL ESTÁTICO. Le habla al rol USUARIO (ver ADR-00 sección 2).
 *
 * DECISIÓN DE UX IMPORTANTE: un participante NO se registra solo — entra con la
 * invitación de su tutor. Por eso esta página es la única del sitio cuyo CTA
 * principal es "Ingresar" y no "Crear cuenta": mandarlo a /registro le haría
 * crear una organización vacía que no es la suya, que es exactamente el error
 * que esta página existe para evitar.
 */
const rol = rolPorSlug('participantes');

const appWebUrl = import.meta.env.PUBLIC_APP_WEB_URL ?? 'http://localhost:4200';

const loQueVes = [
  {
    icono: '📝',
    titulo: 'Tu lista de hoy',
    desc: 'Lo que podés hacer y lo que tenés que hacer, con los puntos que vale cada cosa a la vista. Sin sorpresas después.',
  },
  {
    icono: '📊',
    titulo: 'Tu puntaje en vivo',
    desc: 'Marcás algo y el número se mueve al instante. No hay que esperar a que alguien «cargue las notas».',
  },
  {
    icono: '🎨',
    titulo: 'En qué zona estás',
    desc: 'Y cuánto te falta exactamente para la siguiente. Es la diferencia entre «me está yendo más o menos» y «me faltan 12 puntos».',
  },
  {
    icono: '🎁',
    titulo: 'Qué podés ganar',
    desc: 'Las recompensas de cada zona están publicadas desde el principio. Sabés por qué estás jugando.',
  },
];

const reglas = [
  {
    titulo: 'Nadie te puede bajar el puntaje «porque sí»',
    desc: 'Cada punto que sumás o perdés tiene un motivo registrado, con fecha y con nombre. Si algo no te cierra, podés verlo.',
  },
  {
    titulo: 'Sabés cuánto vale todo antes de hacerlo',
    desc: 'Los valores se definen al principio del período, no sobre la marcha. Nada cambia de precio a mitad de camino.',
  },
  {
    titulo: 'Se arranca sumando, no perdiendo',
    desc: 'La zona más baja es el punto de partida de todos. No es un castigo: es el kilómetro cero.',
  },
  {
    titulo: 'Si te equivocás, se corrige a la vista',
    desc: 'Un error no se borra en silencio. Se agrega la corrección y queda claro qué pasó.',
  },
];
---

<Layout
  title="Para participantes"
  description="Cómo se ve Proyecto Dorado si sos participante: tu lista del día, tu puntaje en vivo, tu zona y las recompensas que podés ganar. Entrás con la invitación de tu tutor."
  path="/para-participantes"
>
  <HeroPagina
    chip="Para participantes · alumnos · integrantes"
    emoji={rol.emoji}
    titulo="Hacé lo tuyo."
    destacado="Mirá cómo sube."
    descripcion="Cada cosa que cumplís vale puntos, y esos puntos te mueven de zona. Está todo a la vista: cuánto tenés, cuánto falta y qué te llevás al final del período."
    acento={rol.acento}
  >
    <div slot="acciones" class="flex flex-wrap justify-center gap-3">
      <a href={`${appWebUrl}/login`} class="btn-primario">Ingresar a mi cuenta</a>
      <a href="/como-funciona" class="btn-secundario">¿Qué es todo esto?</a>
    </div>
  </HeroPagina>

  <!-- Aviso de orientación: el participante no crea la cuenta. -->
  <div class="mx-auto max-w-3xl px-5 pb-4 sm:px-8">
    <p
      class="reveal flex items-start gap-3 rounded-2xl border border-emerald-200
        bg-emerald-50 p-4 text-sm text-emerald-900 dark:border-emerald-800
        dark:bg-emerald-900/30 dark:text-emerald-100"
    >
      <span class="text-base" aria-hidden="true">💡</span>
      <span>
        <strong class="font-semibold">No hace falta que crees una cuenta.</strong>{' '}
        Tu tutor te invita y con eso entrás. Si todavía no te llegó la invitación,
        pedísela — es un correo con un enlace.
      </span>
    </p>
  </div>

  <!-- ===== MOCK DE LA PANTALLA ===== -->
  <section class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div class="reveal order-2 lg:order-1">
        <div class="relative mx-auto max-w-sm">
          <div
            class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br
              from-emerald-500/25 to-zona-dorado/25 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="rounded-3xl border border-slate-200 bg-white p-5 shadow-2xl
              shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/40"
            role="img"
            aria-label="Vista de ejemplo de la pantalla del participante: zona verde con 340 puntos, faltan 60 para dorado, y tres actividades del día."
          >
            <div class="text-center">
              <span
                class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold text-white"
                style="background-color:#22c55e"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-white/80"></span>
                Estás en zona Verde
              </span>
              <p class="mt-4">
                <span class="text-5xl font-extrabold tabular-nums text-slate-900 dark:text-white">340</span>
                <span class="ml-1 text-base font-medium text-slate-400">pts</span>
              </p>
              <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-zona-verde to-zona-dorado"
                  style="width:85%"
                >
                </div>
              </div>
              <p class="mt-2 text-xs font-medium text-slate-400">
                Te faltan 60 para Dorado 🏆
              </p>
            </div>

            <ul class="mt-6 space-y-2">
              <li class="flex items-center justify-between rounded-xl bg-emerald-50 px-3 py-2.5 dark:bg-emerald-900/30">
                <span class="flex items-center gap-2.5 text-sm text-slate-700 dark:text-slate-200">
                  <span class="grid h-5 w-5 place-items-center rounded-full bg-zona-verde text-white" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6L9 17l-5-5"></path>
                    </svg>
                  </span>
                  Leer 20 minutos
                </span>
                <span class="text-sm font-bold text-zona-verde">+15</span>
              </li>
              <li class="flex items-center justify-between rounded-xl border-2 border-dashed border-slate-200 px-3 py-2.5 dark:border-slate-700">
                <span class="flex items-center gap-2.5 text-sm text-slate-500 dark:text-slate-400">
                  <span class="h-5 w-5 rounded-full border-2 border-slate-300 dark:border-slate-600" aria-hidden="true"></span>
                  Práctica de piano
                </span>
                <span class="text-sm font-semibold text-slate-300 dark:text-slate-600">+20</span>
              </li>
              <li class="flex items-center justify-between rounded-xl border-2 border-dashed border-red-200 px-3 py-2.5 dark:border-red-900">
                <span class="flex items-center gap-2.5 text-sm text-slate-500 dark:text-slate-400">
                  <span class="h-5 w-5 rounded-full border-2 border-red-300 dark:border-red-700" aria-hidden="true"></span>
                  Tender la cama
                  <span class="rounded bg-red-100 px-1.5 text-[0.65rem] font-bold text-red-700 dark:bg-red-900/60 dark:text-red-300">
                    obligatoria
                  </span>
                </span>
                <span class="text-sm font-semibold text-red-400">−10</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <h2 class="reveal text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Lo que ves cuando entrás
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            loQueVes.map((v, i) => (
              <div
                class="reveal rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
                style={`--reveal-delay:${(i % 2) * 80}ms`}
              >
                <span class="text-2xl" aria-hidden="true">{v.icono}</span>
                <h3 class="mt-2 font-bold text-slate-900 dark:text-white">{v.titulo}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
                  {v.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LAS REGLAS DEL JUEGO ===== -->
  <section class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950/40">
    <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Las reglas son iguales para todos
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
          Un sistema de puntos solo sirve si es justo. Estas cuatro cosas están
          garantizadas por cómo está hecho, no por buena voluntad.
        </p>
      </div>

      <div class="mt-12 space-y-3">
        {
          reglas.map((r, i) => (
            <article
              class="reveal flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="mt-0.5 grid h-7 w-7 flex-none place-items-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-900/60 dark:text-emerald-300" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white">{r.titulo}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                  {r.desc}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <OtrosRoles slugActual={rol.slug} />

  <!-- ===== CTA ===== -->
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8">
    <div
      class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br
        from-emerald-600 to-emerald-800 px-6 py-14 text-center shadow-2xl
        shadow-emerald-900/30"
    >
      <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
        <div class="absolute -right-10 top-0 h-40 w-40 rounded-full bg-zona-dorado/40 blur-3xl"></div>
      </div>
      <h2 class="relative text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        ¿Ya te invitaron?
      </h2>
      <p class="relative mx-auto mt-3 max-w-lg text-emerald-100">
        Entrá con tu correo y tu contraseña. Tu lista de hoy te está esperando.
      </p>
      <div class="relative mt-7 flex justify-center">
        <a
          href={`${appWebUrl}/login`}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3.5
            text-base font-semibold text-emerald-700 shadow-lg transition-all
            duration-200 hover:-translate-y-0.5 hover:shadow-xl"
        >
          Ingresar
        </a>
      </div>
    </div>
  </section>
</Layout>
