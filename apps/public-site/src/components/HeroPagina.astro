---
/*
 * Hero reutilizable de las páginas internas (/como-funciona, /ayuda y las tres
 * páginas de rol). Mantiene idéntica la altura, el ritmo tipográfico y el halo
 * de fondo en todas, que es justamente lo que hace que el visitante sepa
 * "sigo dentro del mismo sitio" al saltar de una a otra.
 *
 * El acento es opcional: sin él usa la paleta de marca (índigo).
 */
import type { AcentoRol } from '../data/roles';

interface Props {
  /** Texto del chip superior (categoría de la página). */
  chip: string;
  /** Emoji del chip. Decorativo, va aria-hidden. */
  emoji?: string;
  titulo: string;
  /** Fragmento del título que se pinta con el color de acento. */
  destacado?: string;
  descripcion: string;
  acento?: AcentoRol;
}

const { chip, emoji, titulo, destacado, descripcion, acento } = Astro.props;

const clasesChip =
  acento?.chip ??
  'border-marca-200 bg-marca-50 text-marca-700 dark:border-marca-800 dark:bg-marca-900/40 dark:text-marca-300';
const clasesHalo = acento?.halo ?? 'bg-marca-400/25 dark:bg-marca-600/20';
const clasesDestacado = acento?.texto ?? 'text-marca-600 dark:text-marca-400';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class:list={[
        'absolute -top-40 left-1/2 h-[30rem] w-[40rem] -translate-x-1/2 rounded-full blur-3xl',
        clasesHalo,
      ]}
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-5 pb-10 pt-16 text-center sm:px-8 sm:pt-24">
    <span
      class:list={[
        'reveal inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold',
        clasesChip,
      ]}
    >
      {emoji && <span aria-hidden="true">{emoji}</span>}
      {chip}
    </span>

    <h1
      class="reveal mt-5 text-balance text-4xl font-extrabold tracking-tight
        text-slate-900 dark:text-white sm:text-5xl"
      style="--reveal-delay:60ms"
    >
      {/* El {' '} explícito es obligatorio: Astro descarta el nodo de texto en
          blanco entre dos expresiones y el título saldría pegado. */}
      {titulo}{' '}
      {destacado && <span class:list={clasesDestacado}>{destacado}</span>}
    </h1>

    <p
      class="reveal mx-auto mt-5 max-w-2xl text-pretty text-lg leading-relaxed
        text-slate-600 dark:text-slate-300"
      style="--reveal-delay:120ms"
    >
      {descripcion}
    </p>

    <div class="reveal mt-8" style="--reveal-delay:180ms">
      <slot name="acciones" />
    </div>
  </div>
</section>
