---
/*
 * Footer con tres columnas reales. La del medio ("Para vos") es la red de
 * seguridad del sitio: si alguien llegó al fondo de cualquier página sin
 * encontrar lo suyo, acá tiene los tres roles listados a nombre completo.
 */
import { ROLES } from '../data/roles';

const anio = new Date().getFullYear();
// URL de la app (login). En build se puede sobreescribir con PUBLIC_APP_WEB_URL.
const appWebUrl = import.meta.env.PUBLIC_APP_WEB_URL ?? 'http://localhost:4200';

const clasesLink =
  'text-slate-500 transition-colors hover:text-marca-600 dark:text-slate-400 dark:hover:text-marca-400';

const producto = [
  { href: '/', label: 'Inicio' },
  { href: '/como-funciona', label: 'Cómo funciona' },
  { href: '/precios', label: 'Precios' },
  { href: '/ayuda', label: 'Ayuda y preguntas' },
];
---

<footer
  class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5 text-slate-900 dark:text-white">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br
              from-marca-500 to-marca-700 text-sm font-black text-white"
            aria-hidden="true">◆</span
          >
          <span class="text-base font-bold tracking-tight">Proyecto Dorado</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          Convertí actividades y hábitos en un sistema de puntos por zonas, con
          recompensas reales. Para familias, aulas y equipos.
        </p>
      </div>

      <nav aria-labelledby="footer-producto">
        <h2
          id="footer-producto"
          class="mb-3 text-sm font-semibold text-slate-900 dark:text-white"
        >
          Producto
        </h2>
        <ul class="space-y-2 text-sm">
          {
            producto.map((l) => (
              <li>
                <a href={l.href} class={clasesLink}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-roles">
        <h2
          id="footer-roles"
          class="mb-3 text-sm font-semibold text-slate-900 dark:text-white"
        >
          Para vos
        </h2>
        <ul class="space-y-2 text-sm">
          {
            ROLES.map((rol) => (
              <li>
                <a href={rol.href} class={clasesLink}>
                  {rol.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-cuenta">
        <h2
          id="footer-cuenta"
          class="mb-3 text-sm font-semibold text-slate-900 dark:text-white"
        >
          Tu cuenta
        </h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/registro" class={clasesLink}>Crear organización</a></li>
          <li>
            <a href={`${appWebUrl}/login`} class={clasesLink}>Iniciar sesión</a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs
        text-slate-400 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {anio} Proyecto Dorado. Todos los derechos reservados.</p>
      <p>Hecho con foco en la constancia, no en el castigo.</p>
    </div>
  </div>
</footer>
