---
const anio = new Date().getFullYear();
// URL de la app (login). En build se puede sobreescribir con PUBLIC_APP_WEB_URL.
const appWebUrl = import.meta.env.PUBLIC_APP_WEB_URL ?? 'http://localhost:4200';
---

<footer class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5 text-slate-900 dark:text-white">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br
              from-marca-500 to-marca-700 text-sm font-black text-white"
            aria-hidden="true">◆</span
          >
          <span class="text-base font-bold tracking-tight">Proyecto Dorado</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          Convertí actividades y hábitos en un sistema de puntos por zonas, con
          recompensas reales. Para familias, aulas y equipos.
        </p>
      </div>

      <nav class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm" aria-label="Pie de página">
        <span class="col-span-2 mb-1 font-semibold text-slate-900 dark:text-white">
          Producto
        </span>
        <a href="/" class="text-slate-500 hover:text-marca-600 dark:text-slate-400 dark:hover:text-marca-400">Inicio</a>
        <a href="/precios" class="text-slate-500 hover:text-marca-600 dark:text-slate-400 dark:hover:text-marca-400">Precios</a>
        <a href="/registro" class="text-slate-500 hover:text-marca-600 dark:text-slate-400 dark:hover:text-marca-400">Crear cuenta</a>
        <a href={`${appWebUrl}/login`} class="text-slate-500 hover:text-marca-600 dark:text-slate-400 dark:hover:text-marca-400">Iniciar sesión</a>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs
        text-slate-400 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {anio} Proyecto Dorado. Todos los derechos reservados.</p>
      <p>Hecho con foco en la constancia, no en el castigo.</p>
    </div>
  </div>
</footer>
