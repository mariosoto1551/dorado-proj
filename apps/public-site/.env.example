# public-site (Astro) — variables de build. Copiar a .env en desarrollo.
# Las PUBLIC_* se inyectan en el bundle de cliente (island de /registro), así que
# NO poner secretos acá — son visibles en el HTML final.

# URL pública del Gateway (nunca directo a identity-service). El island de
# /registro hace POST {PUBLIC_GATEWAY_URL}/api/auth/organizaciones.
PUBLIC_GATEWAY_URL=http://localhost:3000

# URL de app-web, para el link "Iniciar sesión" tras el registro exitoso.
PUBLIC_APP_WEB_URL=http://localhost:4200

# Dominio de marketing del sitio (canonical, Open Graph, sitemap.xml).
SITE_URL=http://localhost:4321
