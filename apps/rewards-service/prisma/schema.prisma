// Schema de rewards-service (base rewards_db) — fuente: docs/phases/fase-08-rewards.md.
// Convenciones no negociables (ADR-00 §6): IDs uuid v4, multi-tenancy por fila
// (organizacionId + grupoId indexados), referencias a otros servicios SOLO por
// ID (umbralZonaId es de scoring_db — nunca join, se valida por REST interno).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EstadoCatalogo {
  ACTIVA
  ARCHIVADA
}

enum MecanicaRecompensa {
  SELECCION
  AZAR
}

enum EstadoCanje {
  PENDIENTE_ENTREGA
  ENTREGADA
}

// fase-14-22 decisión 1: los dos modos de recompensas, excluyentes por Grupo.
enum ModoRecompensas {
  // fase-08 tal cual: premio por zona al cerrar la Sección. DEFAULT — todo
  // grupo existente (sin fila de configuración) se comporta exactamente así.
  DIRECTO
  // fase-14-22: monedas por zona + tienda.
  TIENDA
}

// fase-14-22: tipos de movimiento del ledger de monedas.
enum TipoMovimientoMoneda {
  // Acreditación al cerrar la Sección (monto >= 0).
  RENDIMIENTO_ZONA
  // Rendimiento negativo de la zona (monto < 0) — dispara la bancarrota.
  MULTA_ZONA
  // Lleva el saldo negativo de vuelta a 0 tras el castigo (decisión 5).
  SALDO_SALDADO
  // Compra en la tienda (monto < 0).
  COMPRA
  // Manual del Tutor, con motivo obligatorio.
  AJUSTE_TUTOR
  // Compensación de una compra revertida.
  REVERSION
}

/**
 * LEDGER DE MONEDAS (fase-14-22 decisión 3, regla 1 de CLAUDE.md aplicada a la
 * economía). NUNCA UPDATE ni DELETE: el saldo es SUM(monto) al leer, no una
 * columna. Las correcciones son filas nuevas.
 *
 * Es el mismo criterio que `EventoPuntos` en scoring — y por el mismo motivo:
 * un saldo materializado se desincroniza y no se puede auditar. SIN updatedAt.
 */
model EventoMoneda {
  id             String               @id @default(uuid())
  organizacionId String
  grupoId        String
  usuarioId      String
  tipo           TipoMovimientoMoneda
  // Con signo ya aplicado (positivo acredita, negativo debita). Int (regla 5).
  monto          Int
  // Sección que originó el movimiento; null en compras y ajustes sueltos.
  seccionId      String?
  // id de la Compra / RendimientoZona / EventoMoneda revertido, según el tipo.
  origenId       String?
  motivo         String?
  registradoPorId String
  // 'TUTOR' | 'USUARIO' | 'SYSTEM'
  registradoPorTipo String
  createdAt      DateTime             @default(now())
  // SIN updatedAt: este modelo nunca se edita, solo se agregan filas nuevas.

  @@index([organizacionId])
  @@index([grupoId, usuarioId])
  @@index([usuarioId, createdAt])
}

/**
 * Config de recompensas por Grupo (fase-14-22). Mutable: es config, no ledger.
 * `modoPendiente` implementa la decisión 9 — el Tutor elige si el cambio de
 * modo aplica ya o al abrir la próxima Sección; en ese caso queda acá y lo
 * consume `SeccionesConsumer`.
 */
model ConfiguracionRecompensasGrupo {
  id             String           @id @default(uuid())
  organizacionId String
  grupoId        String           @unique
  modo           ModoRecompensas  @default(DIRECTO)
  modoPendiente  ModoRecompensas?
  // Cosmético, se muestra tal cual ("12 Doradas"). Sin plural modelado a propósito.
  nombreMoneda   String           @default("monedas")
  iconoMoneda    String           @default("🪙")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizacionId])
}

model Recompensa {
  id             String @id @default(uuid())
  organizacionId String
  grupoId        String
  // referencia a UmbralZona de scoring-service, solo ID, sin join
  umbralZonaId String
  // copiado al crear/editar, para no depender de una llamada en cada lectura
  nombreZonaSnapshot String
  nombre             String
  descripcion        String?
  // white-label (Pro): el backend solo guarda el dato; el gating visual es
  // del frontend contra entitlements (nota de la spec, aplicación en Fase 14)
  imagenUrl        String?
  permiteSeleccion Boolean        @default(false)
  permiteAzar      Boolean        @default(false)
  estado           EstadoCatalogo @default(ACTIVA)
  creadaPorTutorId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizacionId])
  @@index([grupoId])
  @@index([umbralZonaId])
}

model CanjeRecompensa {
  id                  String             @id @default(uuid())
  organizacionId      String
  grupoId             String
  usuarioId           String
  seccionId           String
  recompensaId        String
  mecanica            MecanicaRecompensa
  estado              EstadoCanje        @default(PENDIENTE_ENTREGA)
  entregadaPorTutorId String?
  entregadaEn         DateTime?
  createdAt           DateTime           @default(now())

  // un canje por usuario por Sección en el MVP, sin importar la mecánica
  @@unique([usuarioId, seccionId])
  @@index([organizacionId])
  @@index([grupoId, seccionId])
}

// Idempotencia del consumidor RabbitMQ (ADR-00 §5). En esta fase el consumo
// de ZonaAlcanzada final no tiene efecto de negocio (spec) — la tabla deja la
// infraestructura lista por si a futuro se precomputa elegibilidad.
model EventoProcesado {
  eventId     String   @id
  consumidor  String
  procesadoEn DateTime @default(now())
}
