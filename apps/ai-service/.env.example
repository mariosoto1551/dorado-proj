# ai-service — plantilla de variables de entorno (copiar a .env en este mismo
# directorio y completar). El servicio NO arranca si falta alguna requerida o
# tiene formato inválido (ADR-00 §8, ver src/config/env.schema.ts).

PORT=3009

# Base propia del servicio (una base por servicio — ADR-00 §2).
DATABASE_URL=postgresql://dorado:dorado_dev@localhost:5432/ai_db

# Secreto compartido para llamadas internas salientes (ADR-00 §4).
# Mismo valor en Gateway y en todos los servicios.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod

# Clave pública RS256 (ADR-00 §3), PEM codificado en base64 (una línea).
# El MISMO valor que JWT_PUBLIC_KEY de identity-service (la privada NO va acá:
# solo identity emite tokens).
JWT_PUBLIC_KEY=

# REST interno (ADR-00 §4): billing resuelve si el plan habilita el asistente
# y con qué cuota mensual de tokens (fase-14-29 Parte A).
BILLING_INTERNAL_URL=http://localhost:3002

# REST interno (ADR-00 §4): los cuatro orígenes de las herramientas de lectura
# (fase-14-29 tanda 3). El asistente lee el catálogo, la gente, las zonas y la
# economía del Grupo; NO escribe en ninguno (decisión 6 — aplicar lo hace el
# frontend con el JWT del Tutor contra los endpoints públicos que ya existen).
ACTIVITY_INTERNAL_URL=http://localhost:3003
IDENTITY_INTERNAL_URL=http://localhost:3001
SCORING_INTERNAL_URL=http://localhost:3005
REWARDS_INTERNAL_URL=http://localhost:3006

# ---------------------------------------------------------------------------
# OpenAI (fase-14-29). Los tokens los paga la PLATAFORMA, no el tenant
# (decisión 1): esta key es de la organización de OpenAI de la plataforma y
# ninguna organización cliente carga la suya.
#
# Tiene que ser la key de un SERVICE ACCOUNT de un PROJECT, nunca una key
# personal de un miembro de la organización (una key de usuario muere cuando
# esa persona se va y no se puede acotar). Un project por entorno:
#   dorado-dev · dorado-staging · dorado-prod
# cada uno con su propio límite de gasto mensual configurado en el dashboard
# de OpenAI — así un bucle de reintentos en desarrollo no toca el presupuesto
# de producción.
#
# Esta variable vive SOLO en el entorno de este servicio. Ningún otro backend
# ni app-web la tienen: un bug en otro lado no puede filtrarla.
#
# Opcional hasta la tanda 4 (el loop): sin ella el servicio levanta y la
# configuración funciona, simplemente no hay a quién preguntarle.
OPENAI_API_KEY=

# Modelo a usar. Se elige el vigente al momento de implementar la tanda 4, no
# uno anclado del pasado (mismo criterio que la tabla de versiones de
# CLAUDE.md).
OPENAI_MODEL=gpt-5.6-terra

# Base de la API del proveedor. Vacío = la real (https://api.openai.com/v1).
# Existe SOLO para que la suite E2E pueda apuntar a un stub local
# (fase-14-29 tanda 7): así el cliente HTTP, el parseo y la contabilidad que
# se testean son los MISMOS que corren en producción, y lo único que cambia es
# a quién le habla. Producción NO define esta variable.
OPENAI_BASE_URL=

# Opcional: trace | debug | info | warn | error (default info).
LOG_LEVEL=debug
