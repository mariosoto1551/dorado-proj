# identity-service — plantilla de variables de entorno (copiar a .env en este
# mismo directorio y completar). El servicio NO arranca si falta alguna
# requerida o tiene formato inválido (ADR-00 §8, ver src/config/env.schema.ts).

PORT=3001

# Base propia del servicio (una base por servicio — ADR-00 §2).
DATABASE_URL=postgresql://dorado:dorado_dev@localhost:5432/identity_db

# Broker de eventos de dominio (exchange dorado.events — ADR-00 §5).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Secreto compartido para rutas /internal/* (ADR-00 §4). Mismo valor en
# Gateway y en todos los servicios.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod

# Claves RS256 (ADR-00 §3), PEM codificado en base64 (una línea).
# Generar con: node tools/generar-claves-jwt.mjs
# JWT_PRIVATE_KEY solo vive en identity-service (único emisor de tokens).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# La cookie dorado_refresh lleva `secure` solo donde hay HTTPS (prod).
REFRESH_COOKIE_SECURE=false

# Opcional: trace | debug | info | warn | error (default info).
LOG_LEVEL=debug
