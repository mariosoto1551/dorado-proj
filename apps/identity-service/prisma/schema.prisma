// Schema de identity-service (base identity_db) — fuente: docs/phases/fase-02-identity.md.
// Convenciones no negociables (ADR-00 §6): IDs uuid v4, multi-tenancy por fila
// (organizacionId/grupoId indexados), timestamps createdAt/updatedAt en modelos mutables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RolTutor {
  ORG_ADMIN
  TUTOR
}

enum EstadoCuenta {
  ACTIVO
  INACTIVO
}

enum EstadoOrganizacion {
  ACTIVA
  SUSPENDIDA
}

enum TipoInvitado {
  TUTOR
  USUARIO
}

enum RolEquipoMiembro {
  JEFE
  MIEMBRO
}

enum EstadoInvitacion {
  PENDIENTE
  CANJEADA
  EXPIRADA
  REVOCADA
}

// Cuenta de plataforma (PLATFORM_ADMIN, fase-14-05). Vive POR ENCIMA del tenant:
// única tabla de negocio de identity SIN organizacionId — excepción explícita a
// la regla 3 de CLAUDE.md, porque un admin de plataforma no pertenece a ninguna
// Organización. No se crea por endpoint público: solo por bootstrap de env.
model PlatformAdmin {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  nombre       String
  estado       EstadoCuenta @default(ACTIVO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organizacion {
  id            String             @id @default(uuid())
  nombre        String
  emailContacto String             @unique
  estado        EstadoOrganizacion @default(ACTIVA)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  grupos        Grupo[]
  tutores       Tutor[]
}

model Grupo {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  nombre         String
  // IANA tz, ej "America/La_Paz"
  timezone       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tutorGrupos    TutorGrupo[]
  usuarios       Usuario[]
  usuarioGrupos  UsuarioGrupo[]
  invitaciones   Invitacion[]
  equipos        Equipo[]

  @@index([organizacionId])
}

model Tutor {
  id             String       @id @default(uuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  // Único a nivel PLATAFORMA (no solo organización) — permite login sin elegir organización.
  email          String       @unique
  passwordHash   String
  nombre         String
  rol            RolTutor
  estado         EstadoCuenta @default(ACTIVO)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tutorGrupos    TutorGrupo[]

  @@index([organizacionId])
}

model TutorGrupo {
  id        String   @id @default(uuid())
  tutorId   String
  tutor     Tutor    @relation(fields: [tutorId], references: [id])
  grupoId   String
  grupo     Grupo    @relation(fields: [grupoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tutorId, grupoId])
}

model Usuario {
  id             String       @id @default(uuid())
  organizacionId String
  // Grupo de ORIGEN (el primero al que se unió). La pertenencia REAL —que puede
  // ser a varios grupos de la misma organización (fase-14, revisión de ADR-00 §1)—
  // vive en UsuarioGrupo. Se conserva esta columna para no romper el código que
  // ya la leía; nunca se usa como única fuente de membresía.
  grupoId        String
  grupo          Grupo        @relation(fields: [grupoId], references: [id])
  // Único a nivel PLATAFORMA — mismo motivo que Tutor.email.
  username       String        @unique
  passwordHash   String
  nombre         String
  // Identificador de avatar predefinido, no archivo de imagen.
  avatarId       String
  estado         EstadoCuenta  @default(ACTIVO)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  usuarioGrupos  UsuarioGrupo[]

  @@index([organizacionId])
  @@index([grupoId])
}

// Pertenencia muchos-a-muchos de un Usuario a Grupos de su organización
// (fase-14, revisión de ADR-00 §1: un participante puede estar en varios grupos
// con la MISMA cuenta). Espejo de TutorGrupo. El aislamiento multi-tenant se
// mantiene: solo se vincula a grupos de la organización del propio usuario.
model UsuarioGrupo {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  grupoId   String
  grupo     Grupo    @relation(fields: [grupoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([usuarioId, grupoId])
  @@index([grupoId])
}

// Equipo de trabajo dentro de un Grupo (fase-14-09): agrupa participantes con un
// jefe que impulsa tareas colectivas. Espejo conceptual de la relación Grupo↔Usuario,
// pero un nivel más abajo. El "jefe" NO es un rol de plataforma — es el rol JEFE
// de su fila EquipoMiembro, sigue siendo un Usuario/participante común.
model Equipo {
  id             String          @id @default(uuid())
  organizacionId String
  grupoId        String
  grupo          Grupo           @relation(fields: [grupoId], references: [id])
  nombre         String
  // reusa EstadoCuenta (ACTIVO/INACTIVO); INACTIVO = archivado.
  estado         EstadoCuenta    @default(ACTIVO)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  miembros       EquipoMiembro[]

  @@index([organizacionId])
  @@index([grupoId])
}

// Pertenencia de un Usuario a un Equipo con su rol. Un solo JEFE por equipo
// (invariante garantizado por lógica del service, no expresable como @@unique
// parcial en Prisma). @@unique([grupoId, usuarioId]) fuerza la regla "un usuario
// en un solo equipo por grupo" (decisión 5 de la spec).
model EquipoMiembro {
  id             String           @id @default(uuid())
  organizacionId String
  // denormalizado del Equipo, necesario para el @@unique de un-equipo-por-grupo.
  grupoId        String
  equipoId       String
  equipo         Equipo           @relation(fields: [equipoId], references: [id])
  usuarioId      String
  rol            RolEquipoMiembro @default(MIEMBRO)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([equipoId, usuarioId])
  @@unique([grupoId, usuarioId])
  @@index([organizacionId])
  @@index([usuarioId])
}

model Invitacion {
  id               String           @id @default(uuid())
  organizacionId   String
  grupoId          String
  grupo            Grupo            @relation(fields: [grupoId], references: [id])
  tipoInvitado     TipoInvitado
  // 8 chars, alfanumérico mayúsculas, sin 0/O/1/I.
  codigo           String           @unique
  creadoPorTutorId String
  estado           EstadoInvitacion @default(PENDIENTE)
  expiraEn         DateTime
  // id del Tutor o Usuario creado al canjear.
  canjeadaPorId    String?
  canjeadaEn       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizacionId])
  @@index([grupoId])
}

// Opción (a) de la nota de la spec (fase-02, "Nota Prisma"): `principalId` es un
// string suelto SIN @relation (Prisma no admite dos relaciones distintas sobre el
// mismo scalar field). La integridad referencial hacia Tutor/Usuario se maneja en
// código (TokensService), discriminando por `principalType`.
model RefreshToken {
  id            String   @id @default(uuid())
  // 'TUTOR' | 'USUARIO'
  principalType String
  principalId   String
  tokenHash     String   @unique
  expiraEn      DateTime
  revocado      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([principalId])
}
