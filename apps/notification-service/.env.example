# notification-service — plantilla de variables de entorno (copiar a .env en
# este mismo directorio y completar). El servicio NO arranca si falta alguna
# requerida o tiene formato inválido (ADR-00 §8, ver src/config/env.schema.ts).

PORT=3007

# Base propia del servicio (una base por servicio — ADR-00 §2).
DATABASE_URL=postgresql://dorado:dorado_dev@localhost:5432/notification_db

# Secreto compartido para rutas /internal/* y llamadas internas salientes
# (ADR-00 §4). Mismo valor en Gateway y en todos los servicios.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod

# Clave pública RS256 (ADR-00 §3), PEM codificado en base64 (una línea).
# El MISMO valor que JWT_PUBLIC_KEY de identity-service.
JWT_PUBLIC_KEY=

# RabbitMQ (ADR-00 §5): esta fase CONSUME los 9 eventos notificables
# (no publica nada).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# REST interno (ADR-00 §4): identity para destinatarios (tutores/usuarios del
# grupo) y nombres; activity para nombres de actividades/conductas en las
# plantillas (los payloads de eventos solo traen IDs a propósito).
IDENTITY_INTERNAL_URL=http://localhost:3001
ACTIVITY_INTERNAL_URL=http://localhost:3003

# Opcional: trace | debug | info | warn | error (default info).
LOG_LEVEL=debug
