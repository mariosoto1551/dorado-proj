# Proyecto Dorado — variables de entorno de desarrollo (plantilla)
# Copiar a .env y ajustar. Las variables específicas de cada servicio se
# agregan en la fase que implementa ese servicio (ver docs/phases/).

# --- Infraestructura local (infra/docker-compose.yml) ---
POSTGRES_USER=dorado
POSTGRES_PASSWORD=dorado_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Compartidas entre servicios (se usan a partir de Fase 2, ver ADR-00) ---
# JWT_PUBLIC_KEY=            # clave pública RS256 (la privada solo vive en identity-service)
# GATEWAY_INTERNAL_SECRET=   # header x-internal-secret entre servicios
