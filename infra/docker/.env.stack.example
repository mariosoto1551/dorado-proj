# Claves de DESARROLLO para correr docker-compose.stack.yml (CI/local). No son
# secretos de producción — son las mismas claves de dev que ya viven en los
# apps/*/.env del repo. Para producción, ver .env.prod.example + runbook-deploy-vps.md.
GATEWAY_INTERNAL_SECRET=secreto-interno-dev-cambiar-en-prod
JWT_PUBLIC_
JWT_PRIVATE_
APP_WEB_URL=http://localhost:4200
PUBLIC_SITE_URL=http://localhost:4321
