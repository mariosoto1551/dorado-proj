# Secretos de PRODUCCIÓN para el stack del VPS (docker-compose.prod.yml).
# Copiar a `.env.prod` EN EL VPS y completar. NUNCA se comitea con valores.
#
#   cp infra/docker/.env.prod.example infra/docker/.env.prod
#   # editar infra/docker/.env.prod con los valores reales

# ── Postgres ──
POSTGRES_USER=dorado
POSTGRES_PASSWORD=                # [SECRETO] password fuerte (generar, ej. openssl rand -hex 24)

# ── RabbitMQ ── (corre en el mismo compose; credenciales propias, no guest)
RABBITMQ_USER=dorado
RABBITMQ_PASS=                    # [SECRETO] password fuerte

# ── JWT (RS256) — generar con `node tools/generar-claves-jwt.mjs` ──
JWT_PUBLIC_KEY=                   # clave pública (base64) — la usan los 10 servicios
JWT_PRIVATE_KEY=                  # [SECRETO] clave privada (base64) — solo identity

# ── Secreto interno entre Gateway y servicios ──
GATEWAY_INTERNAL_SECRET=          # [SECRETO] string aleatorio (ej. openssl rand -hex 32)

# ── Dominios ──
GATEWAY_DOMAIN=                   # ej. api.tudominio.com (DNS A → IP del VPS; Caddy saca el cert)
APP_WEB_URL=                      # https://<app-web>.vercel.app  (CORS)
PUBLIC_SITE_URL=                  # https://<public-site>.vercel.app  (CORS)
# ADMIN_WEB_URL — https://<admin-web>.vercel.app (CORS). OPCIONAL: solo si
# desplegás el panel de PLATFORM_ADMIN.
#
# El comentario va ARRIBA y no al lado a propósito. `docker compose` sí saca un
# comentario inline cuando la variable TIENE valor, pero cuando queda vacía se
# lleva el comentario como valor: el Gateway recibiría `ADMIN_WEB_URL="# https…"`,
# no pasaría la validación de URL de su schema y NO ARRANCARÍA. Como esta
# variable está justamente para dejarla vacía, el comentario no puede ir ahí.
ADMIN_WEB_URL=

# ── Asistente de IA (opcional) ──
# Vacío = el asistente queda apagado: /api/ai/* responde 503 y NADA más cambia.
# Se puede completar después y recrear solo ai-service. Los tokens los paga
# quien pone la key: conviene un service account de un project propio de
# OpenAI, con límite de gasto, no una key personal.
# [SECRETO] — sin comentario inline por lo mismo que ADMIN_WEB_URL: vacía es un
# valor válido acá (apaga el asistente), y un comentario al lado se convertiría
# en la key y ai-service no levantaría.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ── Backups (ver scripts/backup-postgres.sh) ──
BACKUP_RETENCION_DIAS=14          # cuántos dumps diarios se conservan
# BACKUP_DIR=/var/backups/dorado  # dónde quedan (default del script si no se define)
