# Variables del stack LIBRE (docker-compose.libre.yml) — el despliegue a
# internet sin costo. Copiar a `.env.libre` EN EL SERVIDOR y completar.
# NUNCA se comitea con valores.
#
#   cp infra/docker/.env.libre.example infra/docker/.env.libre
#   nano infra/docker/.env.libre
#
# Ver docs/runbook-deploy-libre.md.

# ── Dominio ──
# El nombre gratuito de DuckDNS, SIN https:// y sin barra final.
# Ejemplo: destino-dorado.duckdns.org
# Tiene que resolver a la IP pública del servidor ANTES del primer `up`:
# Caddy le pide el certificado a Let's Encrypt al arrancar.
#
# Nota sobre el formato de este archivo: los comentarios de las variables que
# pueden quedar VACÍAS van arriba y nunca al lado. `docker compose` saca el
# comentario inline cuando la variable tiene valor, pero si queda vacía se lo
# lleva COMO valor, y el servicio arranca con basura o directamente no arranca.
DOMINIO=

# ── Postgres ── (no se publica el puerto: solo lo ven los contenedores)
POSTGRES_USER=dorado
POSTGRES_PASSWORD=                # [SECRETO] generar: openssl rand -hex 24

# ── RabbitMQ ── (tampoco se publica)
RABBITMQ_USER=dorado
RABBITMQ_PASS=                    # [SECRETO] generar: openssl rand -hex 24

# ── JWT (RS256) — generar con `node tools/generar-claves-jwt.mjs` ──
JWT_PUBLIC_KEY=                   # clave pública (base64) — la usan los 10 servicios
JWT_PRIVATE_KEY=                  # [SECRETO] clave privada (base64) — solo identity

# ── Secreto interno entre Gateway y servicios ──
GATEWAY_INTERNAL_SECRET=          # [SECRETO] generar: openssl rand -hex 32

# ── Asistente de IA (opcional, y lo ÚNICO que no puede ser gratis) ──
# Vacío = el asistente queda apagado: /api/ai responde 503 y nada más cambia.
# Se puede completar después y recrear solo ai-service. Con uso familiar el
# gasto son centavos al mes, pero conviene un service account de un project
# propio de OpenAI con límite de gasto, no una key personal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ── Backups ──
BACKUP_RETENCION_DIAS=14          # días de dumps que se conservan
BACKUP_HORA=03                    # hora UTC de la corrida diaria

# ── Opcional ──
# LOG_LEVEL=info                  # trace | debug | info | warn | error
