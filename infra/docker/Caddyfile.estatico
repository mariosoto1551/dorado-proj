# Caddy para un sitio estático de verdad (public-site, Astro SSG).
#
# Sin fallback a index.html a propósito: Astro emite un .html por ruta, así que
# una URL inexistente TIENE que dar 404 y no la home.
#
# Escucha en :80 dentro del contenedor; el compose mapea el puerto del host.
:80 {
	root * /srv
	encode zstd gzip

	# Mismas cabeceras que la variante SPA. Acá tampoco va CSP: el island de
	# registro le pega al Gateway en un origen que se deriva del host en
	# tiempo de ejecución (apps/public-site/src/scripts/registro.ts), así que
	# `connect-src` no se puede escribir al compilar. Ver Caddyfile.spa.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(), camera=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	file_server
}
