# Variables del stack del SERVIDOR DE CASA (docker-compose.casa.yml).
# Copiar a `.env.casa` en el servidor y completar. NUNCA se comitea con valores.
#
#   cp infra/docker/.env.casa.example infra/docker/.env.casa
#   nano infra/docker/.env.casa
#
# Son bastantes menos que las de producción: no hay dominio, ni certificados, ni
# URLs de frontend que anotar. Todo lo que dependa de la dirección del servidor
# se resuelve solo (ver docs/runbook-deploy-casa.md).

# ── Postgres ── (no se publica el puerto: solo lo ven los contenedores)
POSTGRES_USER=dorado
POSTGRES_PASSWORD=                # generar: openssl rand -hex 24

# ── RabbitMQ ── (tampoco se publica)
RABBITMQ_USER=dorado
RABBITMQ_PASS=                    # generar: openssl rand -hex 24

# ── JWT (RS256) — generar con `node tools/generar-claves-jwt.mjs` ──
JWT_PUBLIC_KEY=                   # clave pública (base64) — la usan los 10 servicios
JWT_PRIVATE_KEY=                  # [SECRETO] clave privada (base64) — solo identity

# ── Secreto interno entre Gateway y servicios ──
GATEWAY_INTERNAL_SECRET=          # generar: openssl rand -hex 32

# ── Asistente de IA (opcional) ──
# Vacío = el asistente queda apagado y NADA más cambia: /api/ai/* responde 503 y
# el resto del sistema anda igual. Se puede completar después y recrear solo
# ai-service. Los tokens los paga quien pone la key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ── Opcionales ──
# LOG_LEVEL=info                  # trace | debug | info | warn | error
# APP_WEB_URL / PUBLIC_SITE_URL: NO hace falta tocarlas. En casa el permiso de
# CORS lo da CORS_ALLOW_LAN (refleja cualquier origen de la red local), así que
# los defaults de localhost del compose alcanzan.
